---
import Project from "../../views/Project.astro";
import { getSiteData } from "../../lib/sanity/data";

export async function getStaticPaths() {
  const { projects } = await getSiteData("es");
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
---

<Project lang="es" slug={slug!} />
