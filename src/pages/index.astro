---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import HeroTitle from "../components/HeroTitle.astro";
import HeroGrid from "../components/HeroGrid.astro";
import Gallery from "../components/Gallery";
import ProjectGrid from "../components/ProjectGrid.astro";
import PressList from "../components/PressList.astro";
import ShopCta from "../components/ShopCta.astro";
import Footer from "../components/Footer.astro";
import { getSiteData } from "../lib/sanity/data";
import { urlFor } from "../lib/sanity/client";
import { toGalleryPhoto } from "../lib/photos";

const { settings, categories, projects, press } = await getSiteData();

const nonEmptyCategories = categories.filter((c) => c.photos.length > 0);
const galleryPhotos = nonEmptyCategories.flatMap((c) =>
  c.photos.map((p) => toGalleryPhoto(p, c.slug, c.name)),
);
const categoryLinks = nonEmptyCategories.map(({ name, slug }) => ({ name, slug }));

const ogSource = settings.hero[0]?.image ?? nonEmptyCategories[0]?.photos[0];
---

<Layout
  title={`${settings.name} | Photography`}
  description={settings.seoDescription}
  image={ogSource && urlFor(ogSource).width(1200).height(630).fit("crop").url()}
>
  <main class="min-h-screen">
    <Header settings={settings} categories={categoryLinks} hasProjects={projects.length > 0} hasPress={press.length > 0} />
    <HeroTitle eyebrow={settings.tagline} title={settings.name} />
    <HeroGrid items={settings.hero} />
    <section id="gallery" class="max-w-[1440px] mx-auto w-full px-[60px] pt-[50px] pb-5 max-lg:px-6 scroll-mt-6">
      <Gallery client:load photos={galleryPhotos} categories={categoryLinks} />
    </section>
    <ProjectGrid projects={projects} />
    <PressList id="press" items={press} limit={8} />
    <ShopCta url={settings.shopUrl} />
    <Footer settings={settings} />
  </main>
</Layout>
