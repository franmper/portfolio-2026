---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import HeroTitle from "../components/HeroTitle.astro";
import Gallery from "../components/Gallery";
import PressList from "../components/PressList.astro";
import Footer from "../components/Footer.astro";
import { getSiteData } from "../lib/sanity/data";
import { urlFor } from "../lib/sanity/client";
import { autoAlt, toGalleryPhoto } from "../lib/photos";
import { homePath, pathFor, t, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const tr = t(lang);
const { settings, categories, projects, press } = await getSiteData(lang);
const project = projects.find((p) => p.slug === slug)!;
const path = `projects/${project.slug}/`;

const categoryLinks = categories.filter((c) => c.photos.length > 0).map(({ name, slug }) => ({ name, slug }));
const photos = project.photos.map((p, i) => toGalleryPhoto(p, undefined, p.alt || autoAlt(project.name, i + 1, tr.photo)));
const projectPress = press.filter((p) => p.project?.slug === project.slug);
const cover = project.coverImage ?? project.photos[0];
const ogImage = cover && urlFor(cover).width(1200).height(630).fit("crop").url();
const year = project.date?.slice(0, 4);
const eyebrow = [project.category?.name, year].filter(Boolean).join(" · ");

const description =
  project.description ||
  `${tr.photosFrom} ${project.name}. ${photos.length} ${tr.photos}${project.category ? ` ${tr.of} ${project.category.name}` : ""} ${tr.by} ${settings.name}.`;

const pageUrl = new URL(pathFor(lang, path), Astro.site).href;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ImageGallery",
    name: project.name,
    description,
    url: pageUrl,
    inLanguage: lang,
    ...(project.date ? { datePublished: project.date } : {}),
    author: { "@type": "Person", name: settings.name },
    image: photos.slice(0, 50).map((p) => ({
      "@type": "ImageObject",
      contentUrl: p.full[p.full.length - 1].src,
      thumbnailUrl: p.src,
      name: p.alt,
      width: p.width,
      height: p.height,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: settings.name, item: new URL(homePath(lang), Astro.site).href },
      { "@type": "ListItem", position: 2, name: project.name, item: pageUrl },
    ],
  },
];
---

<Layout lang={lang} path={path} title={`${project.name} | ${settings.name}`} description={description} image={ogImage} jsonLd={jsonLd}>
  <main class="min-h-screen">
    <Header settings={settings} categories={categoryLinks} hasProjects={projects.length > 0} hasPress={press.length > 0} lang={lang} path={path} />
    <HeroTitle eyebrow={eyebrow || undefined} title={project.name} />
    {project.description && (
      <div class="max-w-[1440px] mx-auto w-full px-[60px] max-lg:px-6 -mt-2 pb-4 fade-in">
        <p class="max-w-prose text-[14px] leading-relaxed text-text-70">{project.description}</p>
      </div>
    )}
    <section class="max-w-[1440px] mx-auto w-full px-[60px] pt-[30px] pb-5 max-lg:px-6">
      <Gallery client:load photos={photos} pageSize={60} labels={{ all: tr.all, viewMore: tr.viewMore, noPhotos: tr.noPhotos, openPhoto: tr.openPhoto, lightbox: { ...tr.lightbox } }} />
    </section>
    <PressList items={projectPress} lang={lang} />
    <div class="max-w-[1440px] mx-auto w-full px-[60px] pb-10 max-lg:px-6">
      <a href={`${homePath(lang)}#projects`} class="text-[11px] tracking-[2px] uppercase text-text-60 hover:text-text transition-colors">
        {tr.allProjects}
      </a>
    </div>
    <Footer settings={settings} />
  </main>
</Layout>
