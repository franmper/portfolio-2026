---
interface Props {
  eyebrow?: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<section class="flex flex-col gap-2 px-[60px] pt-[30px] pb-5 max-w-[1440px] mx-auto w-full max-lg:px-6 fade-in">
  {eyebrow && <span class="text-[11px] tracking-[3px] text-text-40 uppercase">{eyebrow}</span>}
  <h1 class="text-[48px] tracking-[2px] font-normal uppercase max-md:text-[32px]">
    {title}
  </h1>
</section>
