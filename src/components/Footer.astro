---
import type { SiteSettings } from "../lib/sanity/types";

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
const links = [
  { label: "Instagram", href: settings.instagramUrl, external: true },
  { label: "Behance", href: settings.behanceUrl, external: true },
  { label: "Email", href: settings.email && `mailto:${settings.email}`, external: false },
].filter((l) => l.href);
---

<footer class="max-w-[1440px] mx-auto w-full">
  <div class="mx-[60px] h-px bg-text-10 max-lg:mx-6"></div>
  <div class="flex items-center justify-between px-[60px] pt-8 pb-10 max-lg:px-6 max-md:flex-col max-md:gap-4 max-md:items-start">
    <div class="flex items-center gap-3.5">
      <img src="/images/F.svg" alt="" width="24" height="24" />
      <span class="text-[12px] tracking-[3px] text-text uppercase">{settings.name}</span>
    </div>

    <div class="flex items-center gap-6">
      {links.map((link) => (
        <a
          href={link.href}
          {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          class="text-[10px] tracking-[2px] uppercase text-text-60 hover:text-text transition-colors"
        >
          {link.label}
        </a>
      ))}
    </div>

    <span class="text-[10px] tracking-[2px] text-text-40">{new Date().getFullYear()}</span>
  </div>
</footer>
