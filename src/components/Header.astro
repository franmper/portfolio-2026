---
import { homePath, otherLang, pathFor, t, type Lang } from "../i18n/ui";
import type { CategoryRef, SiteSettings } from "../lib/sanity/types";

interface Props {
  settings: SiteSettings;
  categories: CategoryRef[];
  hasProjects: boolean;
  hasPress: boolean;
  lang: Lang;
  /** Current page path without language prefix, to link to the same page in the other language. */
  path?: string;
}

const { settings, categories, hasProjects, hasPress, lang, path = "" } = Astro.props;
const tr = t(lang);
const home = homePath(lang);
const other = otherLang(lang);
const links = [
  ...categories.map((c) => ({ label: c.name, href: pathFor(lang, `category/${c.slug}/`) })),
  ...(hasProjects ? [{ label: tr.projects, href: `${home}#projects` }] : []),
  ...(hasPress ? [{ label: tr.press, href: `${home}#press` }] : []),
];
---

<header class="flex items-center justify-between px-[60px] py-7 max-w-[1440px] mx-auto w-full max-lg:px-6 max-md:py-4">
  <a href={home} class="shrink-0">
    <img src="/images/F.svg" alt={settings.name} width="36" height="36" />
  </a>

  <div class="flex items-center gap-6">
    <nav class="flex items-center gap-6 max-md:hidden">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-[11px] tracking-[2px] uppercase text-text-70 hover:text-text transition-colors"
        >
          {link.label}
        </a>
      ))}
    </nav>

    {settings.shopUrl && (
      <>
        <div class="w-px h-8 bg-text-10 max-md:hidden"></div>
        <a
          href={settings.shopUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[11px] tracking-[2px] uppercase text-text-70 hover:text-text transition-colors max-md:hidden"
        >
          {tr.shop}
        </a>
      </>
    )}

    {(settings.email || settings.instagram) && (
      <>
        <div class="w-px h-8 bg-text-10 max-md:hidden"></div>
        <div class="flex flex-col gap-0.5 max-md:hidden">
          <span class="text-[13px] tracking-[1px] text-text">{tr.contact}</span>
          {settings.email && (
            <a href={`mailto:${settings.email}`} class="text-[10px] tracking-[0.5px] text-text-50 hover:text-text transition-colors">
              {settings.email}
            </a>
          )}
          {settings.instagram && (
            <a href={settings.instagramUrl} target="_blank" rel="noopener noreferrer" class="text-[10px] tracking-[0.5px] text-text-50 hover:text-text transition-colors">
              {settings.instagram}
            </a>
          )}
        </div>
      </>
    )}

    <a
      href={pathFor(other, path)}
      hreflang={other}
      lang={other}
      class="text-[11px] tracking-[2px] uppercase text-text-50 hover:text-text transition-colors"
      aria-label={other === "en" ? "English" : "Español"}
    >
      {other}
    </a>

    <!-- Mobile menu button -->
    <button id="mobile-menu-btn" class="hidden max-md:flex flex-col gap-[5px] p-1" aria-label={tr.menu}>
      <span class="block w-5 h-px bg-text"></span>
      <span class="block w-5 h-px bg-text"></span>
      <span class="block w-5 h-px bg-text"></span>
    </button>
  </div>
</header>

<!-- Mobile menu overlay -->
<div id="mobile-menu" class="fixed inset-0 bg-bg/95 backdrop-blur-sm z-50 hidden flex-col items-center justify-center gap-6">
  <button id="mobile-menu-close" class="absolute top-5 right-6 text-text p-2" aria-label={tr.closeMenu}>
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
      <line x1="4" y1="4" x2="16" y2="16" />
      <line x1="16" y1="4" x2="4" y2="16" />
    </svg>
  </button>

  {links.map((link) => (
    <a
      href={link.href}
      class="text-[14px] tracking-[3px] uppercase text-text-70 hover:text-text transition-colors mobile-nav-link"
    >
      {link.label}
    </a>
  ))}

  {settings.shopUrl && (
    <a
      href={settings.shopUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-[14px] tracking-[3px] uppercase text-text-70 hover:text-text transition-colors mobile-nav-link"
    >
      {tr.shop}
    </a>
  )}

  <div class="w-12 h-px bg-text-10 mt-4"></div>

  <div class="flex flex-col items-center gap-2 mt-2">
    {settings.email && (
      <a href={`mailto:${settings.email}`} class="text-[11px] tracking-[2px] uppercase text-text-50 hover:text-text transition-colors">
        {tr.email}
      </a>
    )}
    {settings.instagram && (
      <a href={settings.instagramUrl} target="_blank" rel="noopener noreferrer" class="text-[11px] tracking-[2px] uppercase text-text-50 hover:text-text transition-colors">
        {settings.instagram}
      </a>
    )}
  </div>
</div>

<script is:inline>
  const menu = document.getElementById('mobile-menu');

  function setMenu(open) {
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('flex', open);
    document.body.style.overflow = open ? 'hidden' : '';
  }

  document.getElementById('mobile-menu-btn').addEventListener('click', () => setMenu(true));
  document.getElementById('mobile-menu-close').addEventListener('click', () => setMenu(false));
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });
</script>
