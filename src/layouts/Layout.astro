---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Francisco Peralta | Photography",
  description = "Photography portfolio featuring motorsports, shows, travel, nature, and people.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/images/F.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <slot />
  </body>
</html>
